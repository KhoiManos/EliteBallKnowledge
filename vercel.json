{
  "functions": {
    "api/translate.py": {
      "runtime": "python@3.9"
    }
  },
  "builds": [
    { "src": "frontend/**", "use": "@vercel/next" },
    { "src": "api/**", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}